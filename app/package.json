{
  "name": "shotcoach",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "build:static": "BUILD_TARGET=static vite build",
    "build:node": "BUILD_TARGET=node vite build",
    "start": "BUILD_TARGET=node node build",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "lint": "prettier --check . && eslint .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "cap:sync": "npm run build && npx cap sync",
    "verify": "npm run check && npm run lint && npm run test && npm run build && npm run check:size && npm run check:stripped",
    "check:size": "node scripts/check-bundle-size.mjs",
    "check:stripped": "node scripts/check-debug-stripped.mjs",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@capacitor-community/keep-awake": "^7.1.0",
    "@capacitor-community/sqlite": "^7.0.3",
    "@capacitor/android": "^7.6.7",
    "@capacitor/app": "^7.1.2",
    "@capacitor/core": "^7.6.7",
    "@capacitor/filesystem": "^7.1.8",
    "@capacitor/haptics": "^7.0.5",
    "@capacitor/ios": "^7.6.7",
    "@capacitor/screen-orientation": "^7.0.4",
    "basketball-shot-analysis": "file:..",
    "better-auth": "^1.6.23",
    "better-sqlite3": "^12.11.1",
    "sql.js": "^1.14.1",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@capacitor/cli": "^7.6.7",
    "@eslint/js": "^9.18.0",
    "@playwright/test": "1.58.2",
    "@sveltejs/adapter-node": "^5.5.7",
    "@sveltejs/adapter-static": "^3.0.8",
    "@sveltejs/kit": "^2.16.0",
    "@sveltejs/vite-plugin-svelte": "^5.0.0",
    "@testing-library/svelte": "^5.2.4",
    "@testing-library/user-event": "^14.6.1",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.0.0",
    "@types/sql.js": "^1.4.11",
    "@vitest/coverage-v8": "^3.2.0",
    "eslint": "^9.18.0",
    "eslint-plugin-svelte": "^3.0.0",
    "globals": "^15.14.0",
    "jsdom": "^26.0.0",
    "prettier": "^3.4.0",
    "prettier-plugin-svelte": "^3.3.0",
    "svelte": "^5.20.0",
    "svelte-check": "^4.1.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.20.0",
    "vite": "^6.0.0",
    "vitest": "^3.2.0"
