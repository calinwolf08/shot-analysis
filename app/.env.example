# ─────────────────────────────────────────────────────────────────────────
# shotcoach (app) configuration
#
# Copy to `.env` (Vite auto-loads it) and edit as needed:
#   cp .env.example .env
#
# Only VITE_-prefixed vars are exposed to client code, and they are BAKED
# INTO THE BUILD at build time — so a production value must be set BEFORE
# `npm run build`, and must never contain a secret (it ships to browsers).
# For LOCAL DEV the defaults below work with no .env at all.
# ─────────────────────────────────────────────────────────────────────────

# Base URL of the auth-server the app talks to.
# Local dev default (unset): http://localhost:5174
# Production: the public URL of your deployed auth server, e.g.:
#   VITE_AUTH_URL=https://auth.example.com
VITE_AUTH_URL=http://localhost:5174

# Analysis backend. Leave unset for the real MediaPipe pipeline (upload +
# live camera). Set to "replay" to force the deterministic replay backend
# (recorded pose fixtures, no camera/MediaPipe) — useful for UI work.
# VITE_ANALYSIS_BACKEND=replay

# Live-practice debug HUD. Set to 1 to compile the on-screen coordinator
# HUD + console diagnostics into the build (see /practice/live). Leave
# unset for normal/production builds — the HUD is then stripped entirely.
# In a dev build you can instead enable it per-visit with ?debug=live.
# VITE_LIVE_DEBUG=1

# Test/debug surfaces (replay fixture picker, /__debug/* routes, DB hooks).
# Set ONLY by the e2e build; never enable for production.
# VITE_E2E=1
