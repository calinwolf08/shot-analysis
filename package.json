{
  "name": "basketball-shot-analysis",
  "version": "0.1.0",
  "description": "TypeScript module for analyzing basketball shooting form using MediaPipe pose detection",
  "type": "module",
  "workspaces": [
    "app",
    "auth-server"
  ],
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "build:browser": "npx tsx build-browser.ts",
    "check": "tsc --noEmit",
    "test:unit": "vitest",
    "test:integration": "vitest --config vitest.integration.config.ts",
    "test:e2e": "vitest --config vitest.e2e.config.ts",
    "test": "vitest run",
    "test:labels": "tsx src/testing/tolerance-report.ts",
    "metrics:extract": "tsx src/testing/extract-reference-metrics.ts",
    "metrics:thresholds": "tsx src/testing/derive-thresholds.ts",
    "lint": "prettier --check .",
    "format": "prettier --write .",
    "validate": "npm run build:browser && npx tsx server.ts"
  },
  "keywords": [
    "basketball",
    "shot-analysis",
    "mediapipe",
    "pose-detection",
    "sports-analytics"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@types/node": "^22.0.0",
    "@vitest/coverage-v8": "^2.1.9",
    "esbuild": "^0.24.0",
    "prettier": "^3.2.0",
    "tsx": "^4.21.0",
    "typescript": "^5.6.0",
    "vitest": "^2.0.0"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "^0.10.32",
    "zod": "^3.23.0"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
