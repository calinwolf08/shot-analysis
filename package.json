{
  "name": "basketball-shot-analysis",
  "version": "0.1.0",
  "description": "TypeScript module for analyzing basketball shooting form using MediaPipe pose detection",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "check": "tsc --noEmit",
    "test:unit": "vitest",
    "test:integration": "vitest --config vitest.integration.config.ts",
    "test": "vitest run",
    "lint": "prettier --check .",
    "format": "prettier --write ."
  },
  "keywords": [
    "basketball",
    "shot-analysis",
    "mediapipe",
    "pose-detection",
    "sports-analytics"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@vitest/coverage-v8": "^2.1.9",
    "prettier": "^3.2.0",
    "typescript": "^5.6.0",
    "vitest": "^2.0.0"
  },
  "dependencies": {
    "zod": "^3.23.0"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
