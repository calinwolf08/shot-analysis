# ─────────────────────────────────────────────────────────────────────────
# auth-server configuration
#
# Copy to `.env` (which `npm start` auto-loads) and edit as needed.
#   cp .env.example .env
#
# For LOCAL DEV every value below has a working default — you can run the
# server with an empty/absent .env. The one value you MUST set for
# PRODUCTION is AUTH_SECRET.
# ─────────────────────────────────────────────────────────────────────────

# Port the auth server listens on. The app's default VITE_AUTH_URL points
# at 5174, so keep these in sync.
AUTH_PORT=5174

# SQLite file for identity/session tables (created + migrated on boot).
# Relative paths are resolved from the auth-server working directory.
# Use an absolute path on a persistent volume in production.
AUTH_DB=data/auth.sqlite

# Secret used to sign session cookies / tokens.
# REQUIRED IN PRODUCTION — generate a long random value, e.g.:
#   openssl rand -base64 32
# The dev fallback is insecure and must never be used in production.
AUTH_SECRET=

# Comma-separated list of app origins allowed via CORS (and treated as
# trusted by better-auth). Must include EVERY origin the app is served
# from — scheme + host + port, no trailing slash.
# Default (unset): http://localhost:5173, http://localhost:4173,
#                  capacitor://localhost, http://localhost
# Production example:
#   AUTH_TRUSTED_ORIGINS=https://app.example.com,capacitor://localhost,http://localhost
AUTH_TRUSTED_ORIGINS=

# Set to 1 ONLY for the e2e test suite. Exposes /__test/reset-url so tests
# can read the latest password-reset link. NEVER enable in production.
AUTH_E2E=
